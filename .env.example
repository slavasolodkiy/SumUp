# Copy this file to .env and fill in the values.
# Do NOT commit your .env file to version control.

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://payos:payos_dev@localhost:5432/payos

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# REQUIRED in production — server will crash on startup if missing.
SESSION_SECRET=dev-secret-DO-NOT-USE-IN-PRODUCTION

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development

# Port is assigned by Replit automatically; set manually for local dev.
# PORT=4000
